{
  "$comment": "Every stylesheet timing and keyframe maps to a named family or justified effect. Feature animation assets are recorded below and rendered through shared components; `pnpm check:webui-motion` rejects feature-owned timing, interactive transforms, raw motion utilities, business-owned disclosure rotation, direct smooth scrolling and animation-engine use.",
  "families": {
    "feedback": "a control answers pointer, hover, focus or press",
    "surface": "a floating surface enters or leaves",
    "disclosure": "a region opens, closes or resizes",
    "loading": "work is in progress"
  },
  "tokens": {
    "feedback": "120ms",
    "surface": "180ms",
    "disclosure": "160ms",
    "loading": "1.2s",
    "popupExit": "120ms"
  },
  "animationAssets": {
    "assets/lottie/streaming-rose-loader.json": {
      "owner": "features/transcript/ui/ActivityIndicator.tsx",
      "renderer": "ui/feedback.tsx:WebuiLottie",
      "reason": "Transcript-specific rose-loader art; playback lifecycle and reduced-motion policy are shared."
    }
  },
  "files": {
    "features/account/ui/account.css": {
      "durations": [
        { "value": "0.36s", "family": "distinct", "reason": "the approved sign-in success effect" }
      ],
      "keyframes": [
        { "name": "signin-day-claimed", "family": "distinct", "reason": "the approved sign-in success effect" }
      ]
    },
    "features/transcript/ui/transcript-widgets.css": {
      "durations": [],
      "keyframes": []
    },
    "features/transcript/ui/transcript.css": {
      "durations": [
        { "value": "0.18s", "family": "distinct", "reason": "Transcript-specific message entrance" },
        { "value": "1.2s", "family": "distinct", "reason": "Transcript-specific turn-jump highlight" }
      ],
      "keyframes": [
        { "name": "message-appear", "family": "distinct", "reason": "the approved Transcript-specific message entrance" },
        { "name": "webui-turn-jump-flash", "family": "distinct", "reason": "Transcript-specific turn-jump highlight" }
      ]
    },
    "styles/dropdown.css": {
      "durations": [],
      "keyframes": [
        { "name": "webui-dropdown-in", "family": "surface" },
        { "name": "webui-dropdown-in-reverse", "family": "surface" },
        { "name": "webui-dropdown-out", "family": "surface" },
        { "name": "webui-dropdown-out-reverse", "family": "surface" }
      ]
    },
    "styles/feedback.css": {
      "durations": [],
      "keyframes": [
        { "name": "webui-feedback-spin", "family": "loading" }
      ]
    },
    "styles/index.css": {
      "durations": [
        { "value": "0.01ms", "family": "distinct", "reason": "central reduced-motion duration" }
      ],
      "keyframes": []
    },
    "styles/motion.css": {
      "durations": [
        { "value": "0s", "family": "distinct", "reason": "an empty range has no value transition to animate" }
      ],
      "keyframes": [
        { "name": "webui-skeleton-pulse", "family": "loading" },
        { "name": "webui-motion-surface-enter", "family": "surface" },
        { "name": "webui-motion-surface-exit", "family": "surface" },
        { "name": "webui-motion-panel-expand", "family": "surface" },
        { "name": "webui-motion-panel-collapse", "family": "surface" },
        { "name": "webui-motion-panel-exit", "family": "surface" }
      ]
    }
  }
